# Telegram API credentials
# Получить можно на https://my.telegram.org/apps
API_ID=your_api_id
API_HASH=your_api_hash

# Telegram phone number (с кодом страны, например +79991234567)
PHONE=+79991234567

# ID или username канала, из которого парсим посты (например: @channelname или -100123456789)
SOURCE_CHANNEL=@source_channel

# ID или username вашего канала, куда публикуем посты (например: @channelname или -100123456789)
TARGET_CHANNEL=@target_channel

# Интервал проверки новых постов (в секундах)
# Для быстрой реакции на алерты рекомендуется 30-60 секунд
CHECK_INTERVAL=30

# Случайные задержки для безопасности (имитация человеческого поведения)
RANDOM_DELAY=true
DELAY_VARIANCE=5  # Случайная задержка ±5 секунд (25-35 сек при CHECK_INTERVAL=30)

# Пути к файлам с ключевыми фразами (по одной фразе на строку)
KEYWORDS_ALERT_FILE=data/keywords_alert.txt  # Фразы о начале тревоги
KEYWORDS_CLEAR_FILE=data/keywords_clear.txt  # Фразы об отбое тревоги

# Текст шаблона для сообщений о ТРЕВОГЕ
# Используйте \n для переноса строк
# Поддерживается HTML форматирование: <b>жирный</b>, <i>курсив</i>
ALERT_TEMPLATE=⚡⚡⚡ <b>ВНИМАНИЕ ВСЕМ! Воздушная тревога!</b> ⚡⚡⚡

# Текст шаблона для сообщений об ОТБОЕ
# Используйте \n для переноса строк
# Поддерживается HTML форматирование: <b>жирный</b>, <i>курсив</i>
CLEAR_TEMPLATE=✅✅✅ <b>Отбой воздушной тревоги!</b> ✅✅✅

# ГИБРИДНЫЙ РЕЖИМ (опционально, для максимальной безопасности):
# Если указать BOT_TOKEN, публикация будет через Bot API (безопаснее)
# Userbot только читает, классический бот только публикует
# Оставьте пустым, если хотите публиковать через userbot
BOT_TOKEN=your_bot_token_here

# ID чата администратора для уведомлений о сбоях
ADMIN_CHAT_ID=

# MAX Messenger (опционально — оставьте пустым для отключения)
# Токен бота MAX, полученный через @metabot
MAX_BOT_TOKEN=
# chat_id целевого канала MAX (получить через GET /chats)
MAX_TARGET_CHANNEL=

# ВТОРОЙ ИСТОЧНИК — канал энергетиков (Севастопольэнерго): отключения по очередям.
# Оставьте ENERGY_SOURCE_CHANNEL пустым, чтобы отключить эту функцию.
# Посты извлекаются через LLM и публикуются в те же цели (TG + MAX).
ENERGY_SOURCE_CHANNEL=
# Адреса берутся дословно из самого поста Севастопольэнерго — списки не нужны.
# Подпись источника в постах (текстом, без ссылки)
ENERGY_SOURCE_NAME=Севастопольэнерго
# Публиковать посты о СНЯТИИ ограничений (true/false). По умолчанию false —
# публикуются только графики отключений (снятие давало ложные срабатывания).
ENERGY_LIFTED_ENABLED=false

# LLM-шлюз vsellm.ru (OpenAI-совместимый). Ключ из личного кабинета.
LLM_API_KEY=
LLM_BASE_URL=https://api.vsellm.ru/v1
LLM_MODEL=openai/gpt-4.1-nano

# ИСТОЧНИК СИГНАЛОВ ВКОНТАКТЕ (опционально)
# Нужен потому, что в телеграм автор публикует нестабильно и с опозданием,
# а часть сигналов выкладывает КАРТИНКОЙ без подписи — текстом их не поймать.
# Сервисный ключ доступа приложения: dev.vk.ru → Мои приложения → Standalone.
VK_SERVICE_TOKEN=
# Короткое имя страницы: vk.ru/<domain>
VK_DOMAIN=
# Интервал опроса стены, сек. По умолчанию — как у телеграма (CHECK_INTERVAL).
VK_CHECK_INTERVAL=
# Версия API ВК
VK_API_VERSION=5.199

# РАСПОЗНАВАНИЕ КАРТИНОК-ПЛАШЕК
# Знакомые плашки узнаются по перцептивному хешу — мгновенно и бесплатно.
# Модель зрения включается ТОЛЬКО на незнакомой картинке (редко), использует
# LLM_API_KEY и LLM_BASE_URL, указанные выше.
PLATES_DIR=data/plates
VISION_MODEL=openai/gpt-4.1-nano

# СИГНАЛ «МОРСКАЯ ОПАСНОСТЬ» (опционально)
# Пустой шаблон = сигнал не публикуется. Группа сигналов своя: морской отбой
# не отменяет воздушную тревогу, они могут действовать одновременно.
# \n в двойных кавычках даёт перенос строки.
SEA_ALERT_TEMPLATE="🌊🌊🌊 <b>ВНИМАНИЕ ВСЕМ! Морская опасность!</b> 🌊🌊🌊\n\n<i>Отойдите от воды не менее чем на 100 метров и укройтесь в капитальном строении или укрытии.</i>"
SEA_CLEAR_TEMPLATE="✅✅✅ <b>Отбой морской опасности!</b> ✅✅✅"
KEYWORDS_SEA_ALERT_FILE=data/keywords_sea_alert.txt
KEYWORDS_SEA_CLEAR_FILE=data/keywords_sea_clear.txt

# Окно, в котором повтор ТОГО ЖЕ сигнала считается дублем (сек).
# Считается по состоянию сигнала и сбрасывается противоположным сигналом,
# поэтому окно широкое: один сигнал приходит из ВК и из телеграма с разбегом
# в минуты. Бесконечным быть не может — пропущенный отбой заглушил бы
# следующую тревогу.
SIGNAL_DEDUP_SECONDS=1800
